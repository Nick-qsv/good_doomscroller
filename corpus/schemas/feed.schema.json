{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nick-qsv/good_doomscroller/corpus/schemas/feed.schema.json",
  "title": "Good Doomscroller verified passage feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pipelineVersion", "book", "passages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pipelineVersion": { "type": "string" },
    "verificationBundle": { "$ref": "#/$defs/verificationBundle" },
    "book": { "$ref": "#/$defs/book" },
    "passages": {
      "type": "array",
      "items": { "$ref": "#/$defs/passage" }
    }
  },
  "$defs": {
    "verificationBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "normalizationVersion",
        "offsetUnit",
        "originalSourceBase64",
        "chapters"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "normalizationVersion": {
          "const": "1"
        },
        "offsetUnit": {
          "const": "unicode-code-points"
        },
        "originalSourceBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "ordinal",
              "title",
              "locator",
              "text",
              "contentSha256",
              "paragraphs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "contentSha256": {
                "$ref": "#/$defs/sha256"
              },
              "paragraphs": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    "aiContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "generatedBy",
        "generatedAt"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "generatedBy": {
          "const": "AI"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,6})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
        }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "jurisdiction", "basis"],
      "properties": {
        "status": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "basis": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fileName",
        "kind",
        "mediaType",
        "url",
        "downloadUrl",
        "version",
        "retrievedAt",
        "sha256",
        "normalizedSha256",
        "rights"
      ],
      "properties": {
        "name": { "type": "string" },
        "fileName": { "type": "string" },
        "kind": { "enum": ["epub", "xhtml", "text"] },
        "mediaType": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "downloadUrl": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "normalizedSha256": { "$ref": "#/$defs/sha256" },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "editionId", "slug", "title", "authors", "language", "source"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "editionId": { "type": "string", "format": "uuid" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "language": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "title", "locator"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "locator": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256",
        "chapterSha256",
        "startSentenceId",
        "endSentenceId",
        "startSentenceOrdinal",
        "endSentenceOrdinal",
        "startOffset",
        "endOffset",
        "quoteSha256"
      ],
      "properties": {
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "chapterSha256": { "$ref": "#/$defs/sha256" },
        "startSentenceId": { "type": "string" },
        "endSentenceId": { "type": "string" },
        "startSentenceOrdinal": { "type": "integer", "minimum": 1 },
        "endSentenceOrdinal": { "type": "integer", "minimum": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 },
        "quoteSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "model",
        "score",
        "rank",
        "reason",
        "themes",
        "contentFlags"
      ],
      "properties": {
        "selector": { "enum": ["heuristic", "openai"] },
        "model": { "type": ["string", "null"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "rank": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "themes": { "type": "array", "items": { "type": "string" } },
        "contentFlags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bookId",
        "editionId",
        "text",
        "title",
        "authors",
        "wordCount",
        "status",
        "qualityScore",
        "chapter",
        "provenance",
        "curation"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "bookId": { "type": "string", "format": "uuid" },
        "editionId": { "type": "string", "format": "uuid" },
        "text": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "wordCount": { "type": "integer", "minimum": 1 },
        "status": { "const": "candidate" },
        "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "chapter": { "$ref": "#/$defs/chapter" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "curation": { "$ref": "#/$defs/curation" },
        "aiContext": { "$ref": "#/$defs/aiContext" }
      }
    }
  }
}
